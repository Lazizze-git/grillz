# Maison Alliani — configuration Apache (hébergement Infomaniak)
# Domaine canonique : https://maison-alliani.com (sans www)

# ---- Fichiers de service : jamais servis au visiteur ----
# spam-filter.php est inclus par envoi.php ; il n'a aucune existence publique.
<FilesMatch "^spam-filter\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Dossier de travail du filtre (journal, compteurs, empreintes). Il se crée
# tout seul côté serveur et pose aussi son propre .htaccess : le déploiement
# FTP ne l'emporte pas avec lui.
RedirectMatch 403 ^/\.antispam(/|$)

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS obligatoire
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://maison-alliani.com%{REQUEST_URI} [R=301,L]

  # www → domaine nu
  RewriteCond %{HTTP_HOST} ^www\.maison-alliani\.com$ [NC]
  RewriteRule ^ https://maison-alliani.com%{REQUEST_URI} [R=301,L]

  # ---- Adresses sans « .html » ----
  # Une page a une seule adresse : /galerie. Toutes les autres formes y
  # redirigent de façon permanente, pour que Google n'en indexe qu'une et que
  # les anciens liens continuent de fonctionner.

  # L'accueil ne s'écrit pas « /index ».
  RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?] [NC]
  RewriteRule ^ / [R=301,L]

  # /galerie.html → /galerie
  RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # /galerie/ → /galerie
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # /galerie sert galerie.html, sans que l'adresse affichée change.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# Encodage par défaut
AddDefaultCharset UTF-8

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Cache navigateur
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
